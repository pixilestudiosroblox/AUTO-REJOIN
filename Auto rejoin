    return f
end

-- Toggle switch
local function makeToggle(parent, onChange)
    local track = New("TextButton", {
        Size             = UDim2.new(0, 50, 0, 28),
        Position         = UDim2.new(1, -58, 0.5, -14),
        BackgroundColor3 = BORDER,
        BorderSizePixel  = 0,
        Text             = "",
        AutoButtonColor  = false,
    }, parent)
    corner(100, track)

    local knob = New("Frame", {
        Size             = UDim2.new(0, 22, 0, 22),
        Position         = UDim2.new(0, 3, 0.5, -11),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel  = 0,
    }, track)
    corner(100, knob)

    local on = false
    track.MouseButton1Click:Connect(function()
        on = not on
        track.BackgroundColor3 = on and GREEN or BORDER
        knob.Position = on
            and UDim2.new(1, -25, 0.5, -11)
            or  UDim2.new(0,  3,  0.5, -11)
        onChange(on)
    end)
    return track
end

-- Same / New server picker
local function makeModePicker(parent, defaultMode, onChange)
    local row = New("Frame", {
        Size             = UDim2.new(1, -16, 0, 34),
        Position         = UDim2.new(0, 8, 1, -42),
        BackgroundTransparency = 1,
    }, parent)
    New("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal,
        Padding       = UDim.new(0, 6),
    }, row)

    local function makeBtn(label, mode)
        local active = (mode == defaultMode)
        local b = New("TextButton", {
            Size             = UDim2.new(0.5, -3, 1, 0),
            BackgroundColor3 = active and ACCENT or BORDER,
            BorderSizePixel  = 0,
            Text             = label,
            TextColor3       = WHITE,
            TextSize         = 13,
            Font             = Enum.Font.GothamMedium,
            AutoButtonColor  = false,
        }, row)
        corner(8, b)
        return b
    end

    local bSame = makeBtn("Same Server", "Same")
    local bNew  = makeBtn("New Server",  "New")

    local function pick(m)
        bSame.BackgroundColor3 = m == "Same" and ACCENT or BORDER
        bNew.BackgroundColor3  = m == "New"  and ACCENT or BORDER
        onChange(m)
    end

    bSame.MouseButton1Click:Connect(function() pick("Same") end)
    bNew.MouseButton1Click:Connect(function()  pick("New")  end)
end

-- Drag slider
local function makeSlider(parent, minV, maxV, defaultV, onChangeFn)
    local pct = (defaultV - minV) / (maxV - minV)

    local track = New("Frame", {
        Size             = UDim2.new(1, -20, 0, 24),
        Position         = UDim2.new(0, 10, 1, -32),
        BackgroundColor3 = BORDER,
        BorderSizePixel  = 0,
    }, parent)
    corner(100, track)

    local fill = New("Frame", {
        Size             = UDim2.new(pct, 0, 1, 0),
        BackgroundColor3 = ACCENT,
        BorderSizePixel  = 0,
    }, track)
    corner(100, fill)

    local thumb = New("Frame", {
        Size             = UDim2.new(0, 20, 0, 20),
        Position         = UDim2.new(pct, -10, 0.5, -10),
        BackgroundColor3 = WHITE,
        BorderSizePixel  = 0,
    }, track)
    corner(100, thumb)

    local function applyX(absX)
        local rel = math.clamp((absX - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
        local val = math.floor(rel * (maxV - minV) + minV + 0.5)
        fill.Size      = UDim2.new(rel, 0, 1, 0)
        thumb.Position = UDim2.new(rel, -10, 0.5, -10)
        onChangeFn(val)
    end

    local dragging = false

    local clickBtn = New("TextButton", {
        Size             = UDim2.new(1, 0, 1, 0),
        BackgroundTransparency = 1,
        BorderSizePixel  = 0,
        Text             = "",
        ZIndex           = 2,
    }, track)

    clickBtn.MouseButton1Down:Connect(function()
        dragging = true
    end)

    UserInputService.InputChanged:Connect(function(inp)
        if not dragging then return end
        if inp.UserInputType == Enum.UserInputType.MouseMovement
        or inp.UserInputType == Enum.UserInputType.Touch then
            applyX(inp.Position.X)
        end
    end)

    UserInputService.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1
        or inp.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    -- Also handle tap on track
    clickBtn.MouseButton1Click:Connect(function()
        local mp = UserInputService:GetMouseLocation()
        applyX(mp.X)
    end)
end

