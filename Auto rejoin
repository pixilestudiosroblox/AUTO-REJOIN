-- ── 2. Services ───────────────────────────────────────────────────────────────

local Players          = game:GetService("Players")
local TeleportService  = game:GetService("TeleportService")
local RunService       = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

-- ── 3. Local player safety ────────────────────────────────────────────────────

local LocalPlayer = Players.LocalPlayer
if not LocalPlayer then
    LocalPlayer = Players:GetPropertyChangedSignal("LocalPlayer"):Wait()
    LocalPlayer = Players.LocalPlayer
end

local PlayerGui = LocalPlayer:WaitForChild("PlayerGui", 15)
if not PlayerGui then
    warn("[AutoRejoin] PlayerGui not found — aborting")
    return
end

-- ── 4. Game info ──────────────────────────────────────────────────────────────

local placeId = tostring(game.PlaceId)
local jobId   = tostring(game.JobId)

-- ── 5. State ──────────────────────────────────────────────────────────────────

local rejoinEnabled    = false
local rejoinMode       = "Same"   -- "Same" | "New"
local rejoinInterval   = 30
local rejoinCountdown  = 30
local rejoinConn       = nil

local reconnectEnabled = false
local reconnectMode    = "Same"
local reconnectDelay   = 5
local kickConn         = nil
local teleFailConn     = nil

local rjStatusLabel    = nil
local rcStatusLabel    = nil

-- ── 6. Teleport helper ────────────────────────────────────────────────────────

local function doTeleport(mode)
    local ok, err = pcall(function()
        if mode == "Same" then
            TeleportService:TeleportToPlaceInstance(placeId, jobId, LocalPlayer)
        else
            TeleportService:Teleport(placeId, LocalPlayer)
        end
    end)
    if not ok then
        warn("[AutoRejoin] Teleport failed:", err)
    end
end

-- ── 7. Reconnect listeners ────────────────────────────────────────────────────

-- BindToClose fires on disconnect / server shutdown
-- Registered once at script load; gated by reconnectEnabled flag
game:BindToClose(function()
    if not reconnectEnabled then return end
    pcall(function()
        if rcStatusLabel then rcStatusLabel.Text = "Disconnected — reconnecting..." end
    end)
    doTeleport(reconnectMode)
    task.wait(reconnectDelay + 3)
end)

local function startReconnectListeners()
    -- Kicked event fires specifically when the server kicks YOU
    if not kickConn then
        kickConn = LocalPlayer.Kicked:Connect(function()
            if not reconnectEnabled then return end
            pcall(function()
                if rcStatusLabel then
                    rcStatusLabel.Text = "Kicked! Reconnecting in " .. reconnectDelay .. "s"
                end
            end)
            task.wait(reconnectDelay)
            if reconnectEnabled then
                doTeleport(reconnectMode)
            end
        end)
    end

    -- Retry if the teleport itself errors
    if not teleFailConn then
        teleFailConn = TeleportService.TeleportInitFailed:Connect(function(player, result, msg)
            if player ~= LocalPlayer or not reconnectEnabled then return end
            warn("[AutoRejoin] TeleportInitFailed:", result, msg)
            task.delay(reconnectDelay, function()
                if reconnectEnabled then
                    doTeleport(reconnectMode)
                end
            end)
        end)
    end
end

local function stopReconnectListeners()
    if kickConn     then kickConn:Disconnect();     kickConn     = nil end
    if teleFailConn then teleFailConn:Disconnect();  teleFailConn = nil end
end

