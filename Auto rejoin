sectionHeader("Auto Rejoin — timer based")

-- Toggle card
local rjTogCard = card(56)
txt("Auto Rejoin", 13, WHITE, rjTogCard, {
    sz  = UDim2.new(0.65, 0, 0, 20),
    pos = UDim2.new(0, 12, 0, 8),
})
rjStatusLabel = txt("Status: Off", 11, MUTED, rjTogCard, {
    sz  = UDim2.new(0.65, 0, 0, 18),
    pos = UDim2.new(0, 12, 0, 28),
})
makeToggle(rjTogCard, function(on)
    rejoinEnabled   = on
    rejoinCountdown = rejoinInterval
    if on then
        rejoinConn = RunService.Heartbeat:Connect(function(dt)
            if not rejoinEnabled then return end
            rejoinCountdown = rejoinCountdown - dt
            pcall(function()
                local modeStr = rejoinMode == "Same" and "Same" or "New"
                rjStatusLabel.Text       = modeStr .. " | " .. math.max(0, math.floor(rejoinCountdown)) .. "s"
                rjStatusLabel.TextColor3 = GREEN
            end)
            if rejoinCountdown <= 0 then
                rejoinCountdown = rejoinInterval
                doTeleport(rejoinMode)
            end
        end)
    else
        if rejoinConn then rejoinConn:Disconnect(); rejoinConn = nil end
        pcall(function()
            rjStatusLabel.Text       = "Status: Off"
            rjStatusLabel.TextColor3 = MUTED
        end)
    end
end)

